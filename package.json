{
  "name": "joki",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS=\"${NODE_OPTIONS:+$NODE_OPTIONS }--disable-warning=DEP0040\" next dev -p 3023",
    "build": "eslint . --max-warnings=-1 && next build",
    "start": "NODE_OPTIONS=\"${NODE_OPTIONS:+$NODE_OPTIONS }--disable-warning=DEP0040\" next start -p 3023",
    "lint": "eslint .",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test:commit-naming": "node --test .github/scripts/validate-commit-naming.test.mjs",
    "test:eslint-rules": "node --test eslint-rules/*.test.js",
    "storybook": "HOME=.home XDG_CACHE_HOME=.cache storybook dev -p 6006",
    "build-storybook": "HOME=.home XDG_CACHE_HOME=.cache storybook build",
    "test:unit": "vitest run --project=unit",
    "test:storybook": "HOME=.home XDG_CACHE_HOME=.cache PLAYWRIGHT_BROWSERS_PATH=.cache/ms-playwright vitest run --project=storybook",
    "chromatic": "HOME=.home XDG_CACHE_HOME=.cache chromatic",
    "cypress:open": "XDG_CONFIG_HOME=.cache/config CYPRESS_CACHE_FOLDER=.cache/Cypress PLAYWRIGHT_BROWSERS_PATH=.cache/ms-playwright cypress open",
    "cypress:install-browsers": "XDG_CONFIG_HOME=.cache/config CYPRESS_CACHE_FOLDER=.cache/Cypress cypress install && PLAYWRIGHT_BROWSERS_PATH=.cache/ms-playwright playwright install firefox webkit",
    "cypress:run": "XDG_CONFIG_HOME=.cache/config CYPRESS_CACHE_FOLDER=.cache/Cypress PLAYWRIGHT_BROWSERS_PATH=.cache/ms-playwright cypress run",
    "cypress:run:electron": "XDG_CONFIG_HOME=.cache/config CYPRESS_CACHE_FOLDER=.cache/Cypress cypress run --browser electron",
    "cypress:run:chrome": "XDG_CONFIG_HOME=.cache/config CYPRESS_CACHE_FOLDER=.cache/Cypress cypress run --browser chrome",
    "cypress:run:chromium": "XDG_CONFIG_HOME=.cache/config CYPRESS_CACHE_FOLDER=.cache/Cypress cypress run --browser chromium",
    "cypress:run:edge": "XDG_CONFIG_HOME=.cache/config CYPRESS_CACHE_FOLDER=.cache/Cypress cypress run --browser edge",
    "cypress:run:firefox": "FIREFOX_BIN=$(find .cache/ms-playwright -type f -path '*/firefox/firefox' -print -quit) && test -n \"$FIREFOX_BIN\" && XDG_CONFIG_HOME=.cache/config CYPRESS_CACHE_FOLDER=.cache/Cypress cypress run --browser \"$FIREFOX_BIN\"",
    "cypress:run:webkit": "XDG_CONFIG_HOME=.cache/config CYPRESS_CACHE_FOLDER=.cache/Cypress PLAYWRIGHT_BROWSERS_PATH=.cache/ms-playwright cypress run --browser webkit",
    "cypress:run:all-browsers": "pnpm cypress:run:electron && pnpm cypress:run:chrome && pnpm cypress:run:chromium && pnpm cypress:run:edge && pnpm cypress:run:firefox && pnpm cypress:run:webkit",
    "test:e2e": "start-server-and-test dev http://127.0.0.1:3023 cypress:run:electron",
    "test:e2e:all-browsers": "start-server-and-test dev http://127.0.0.1:3023 cypress:run:all-browsers",
    "update-types": "echo 'STALE — do not run. The live DB is shared with other projects (19_*, 28_*, etc.), so pnpx supabase gen would overwrite app/ts/types_db.ts with unrelated tables. Edit types_db.ts manually instead. See app/ts/dev_readme.md.'"
  },
  "dependencies": {
    "@aws-sdk/client-lambda": "^3.1024.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@metamask/detect-provider": "^2.0.0",
    "@pinecone-database/pinecone": "^7.1.0",
    "@react-email/body": "^0.2.1",
    "@react-email/button": "^0.0.10",
    "@react-email/container": "^0.0.16",
