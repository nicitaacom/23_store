    "@tiptap/starter-kit": "^3.27.1",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.36.1",
    "autoprefixer": "10.4.16",
    "class-variance-authority": "^0.7.0",
    "disposable-email-domains": "^1.0.62",
    "framer-motion": "^12.42.2",
    "gsap": "^3.15.0",
